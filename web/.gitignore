# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Generated mock data (regenerate with `npm run mock`) — ignored.
# EXCEPTION: the embedded REAL precomputed scene (demo-0001) IS tracked so the
# deployed dashboard ships genuine model output. Regenerate it with:
#   make demo && python scripts/embed_demo_scene.py
public/data/*
!public/data/demo-0001/
# scenes.json is regenerated by both the embed script and `npm run mock`; track it
# so the deployed build advertises the embedded real scene.
!public/data/scenes.json

# Vite cache
.vite/
*.local

# Editor / OS
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript incremental build info
*.tsbuildinfo
